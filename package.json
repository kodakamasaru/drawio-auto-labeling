{
  "name": "vscode-drawio-cmd-drag-label",
  "displayName": "Drawio Cmd-Drag Label",
  "description": "Hold Cmd while dragging a shape from the drawio sidebar to auto-label it with the shape's display name.",
  "version": "0.0.1",
  "publisher": "kodakamasaru",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "drawio",
    "diagram",
    "label",
    "shortcut"
  ],
  "extensionDependencies": [
    "hediet.vscode-drawio"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Drawio Cmd-Drag Label",
      "properties": {
        "vscode-drawio-cmd-drag-label.modifierKey": {
          "type": "string",
          "enum": [
            "cmd",
            "ctrl",
            "alt",
            "shift",
            "ctrlOrCmd"
          ],
          "enumDescriptions": [
            "⌘ on macOS / ⊞ on Windows (metaKey)",
            "Ctrl",
            "Alt / Option",
            "Shift",
            "⌘ on macOS, Ctrl on Windows / Linux"
          ],
          "default": "cmd",
          "description": "Modifier key to hold while dragging from the drawio sidebar to apply the auto-label."
        },
        "vscode-drawio-cmd-drag-label.dictionary": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map from a sidebar shape title (e.g. \"Secrets Manager\") to a custom label. Titles not in the map fall back to using the title as-is. Set the value to an empty string to suppress labeling for that title."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kodakamasaru/vscode-drawio-cmd-drag-label.git"
  },
  "license": "MIT"
}
