{
  "name": "drawio-auto-labeling",
  "displayName": "Draw.io Auto Labeling",
  "description": "Hold a configurable modifier key while dragging a shape from the drawio sidebar to auto-label it with the shape's name. Supports a user dictionary to remap titles to custom labels.",
  "version": "0.0.3",
  "publisher": "kodakamasaru",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "keywords": [
    "drawio",
    "diagram",
    "auto-label",
    "labeling",
    "shortcut"
  ],
  "extensionDependencies": [
    "hediet.vscode-drawio"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Draw.io Auto Labeling",
      "properties": {
        "drawio-auto-labeling.modifierKey": {
          "type": "string",
          "enum": [
            "cmd",
            "ctrl",
            "alt",
            "shift"
          ],
          "enumDescriptions": [
            "⌘ on macOS / ⊞ on Windows (metaKey)",
            "Ctrl",
            "Alt / Option",
            "Shift"
          ],
          "default": "cmd",
          "description": "Modifier key to hold while dragging from the drawio sidebar to apply the auto-label."
        },
        "drawio-auto-labeling.dictionary": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map from a sidebar shape title (e.g. \"Secrets Manager\") to a custom label. Titles not in the map fall back to using the title as-is. Set the value to an empty string to suppress labeling for that title."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kodakamasaru/drawio-auto-labeling.git"
  },
  "license": "MIT"
}
